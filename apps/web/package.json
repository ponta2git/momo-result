{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm run generate:api",
    "dev": "vite",
    "build": "tsc && vite build",
    "e2e": "node ./scripts/e2e-isolated.mjs",
    "e2e:target": "playwright test",
    "e2e:runtime": "PLAYWRIGHT_SKIP_WEB_SERVER=1 playwright test",
    "preview": "vite preview",
    "pretypecheck": "pnpm run generate:api",
    "typecheck": "tsc --pretty false",
    "test": "vitest",
    "pretest:coverage": "pnpm run generate:api",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage:report": "pnpm run generate:api",
    "test:coverage:report": "COVERAGE_REPORT_ONLY=1 vitest run --coverage",
    "pretest:run": "pnpm run generate:api",
    "test:run": "vitest run",
    "prelint": "pnpm run generate:api",
    "lint": "oxlint . && node ./scripts/check-architecture-imports.mjs && node ./scripts/check-api-contract.mjs && node ./scripts/check-ui-consistency.mjs && node ./scripts/check-module-size.mjs",
    "lint:fix": "oxlint . --fix",
    "lint:react-perf": "oxlint --react-perf-plugin src --ignore-pattern \"**/*.test.*\" --ignore-pattern \"**/__tests__/**\"",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate:api": "node ./scripts/generate-api.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
