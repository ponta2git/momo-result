{
  "schemaVersion": 1,
  "calculationInput": [
    {
      "relation": "matches",
      "columns": [
        "id",
        "analysis_revision",
        "played_at",
        "held_event_id",
        "match_no_in_event",
        "game_title_id",
        "season_master_id",
        "map_master_id"
      ]
    },
    {
      "relation": "match_players",
      "columns": [
        "match_id",
        "member_id",
        "play_order",
        "rank",
        "total_assets_man_yen",
        "revenue_man_yen"
      ]
    },
    {
      "relation": "match_incidents",
      "columns": ["match_id", "member_id", "incident_master_id", "count"]
    }
  ],
  "revisionGuard": [
    {
      "relation": "series_analysis_title_states",
      "columns": ["game_title_id", "input_revision"]
    },
    { "relation": "game_titles", "columns": ["id"] }
  ],
  "displayHydration": [
    { "relation": "game_titles", "columns": ["name", "display_order"] },
    { "relation": "season_masters", "columns": ["name", "display_order"] },
    { "relation": "map_masters", "columns": ["name", "display_order"] },
    { "relation": "members", "columns": ["display_name"] }
  ],
  "excludedRelations": ["held_events", "member_aliases", "incident_masters"]
}
