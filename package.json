{
  "name": "momo-result",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:launcher:test": "node --test scripts/dev-local.test.mjs",
    "api:format": "cd apps/api && sbt apiFormat",
    "api:format:check": "cd apps/api && sbt apiFormatCheck",
    "api:lint": "cd apps/api && sbt apiLint",
    "api:quality": "cd apps/api && sbt apiQuality",
    "api:test": "cd apps/api && sbt test",
    "api:coverage": "cd apps/api && sbt apiCoverage",
    "api:coverage:report": "cd apps/api && sbt apiCoverageReportOnly",
    "analysis:format": "cargo fmt --all --manifest-path apps/analysis-worker/Cargo.toml",
    "analysis:format:check": "cargo fmt --all --check --manifest-path apps/analysis-worker/Cargo.toml",
    "analysis:lint": "cargo clippy --locked --manifest-path apps/analysis-worker/Cargo.toml --workspace --all-targets --all-features -- -D warnings",
    "analysis:test": "cargo test --locked --manifest-path apps/analysis-worker/Cargo.toml --workspace --all-targets --all-features",
    "actionlint": "scripts/ci/actionlint.sh",
    "public:safety:check": "scripts/ci/public-repo-safety-check.sh",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:e2e": "pnpm --filter web e2e",
    "web:e2e:target": "pnpm --filter web e2e:target",
    "web:e2e:runtime": "pnpm --filter web e2e:runtime",
    "web:test": "pnpm --filter web test:run",
    "web:test:coverage:report": "pnpm --filter web test:coverage:report",
    "web:typecheck": "pnpm --filter web typecheck"
  }
}
