{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ./scripts/check-built-theme.mjs",
    "e2e": "node ./scripts/e2e-isolated.mjs",
    "e2e:target": "playwright test",
    "e2e:runtime": "PLAYWRIGHT_SKIP_WEB_SERVER=1 playwright test",
    "preview": "vite preview",
    "typecheck": "tsc --pretty false",
    "test": "vitest",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:run": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate:api": "node ./scripts/generate-api.mjs",
    "contract:check": "redocly lint --config ../api/redocly.yaml ../api/openapi.yaml && node ./scripts/generate-api.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.51.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
