{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momo-result.local/schemas/series-analysis-queue-payload-v1.schema.json",
  "title": "Series analysis Redis Streams payload v1",
  "description": "Exact Redis Streams field/value wire representation. Redis returns each field value as bytes decoded here as a JSON string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jobId"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
